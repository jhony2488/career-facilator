{
  "name": "career-facilitator-ts",
  "version": "0.1.0",
  "private": true,
  "description": "CareerFacilator AI — autonomous job prospecting, semantic triage, resume tailoring and assisted application with inference optimization",
  "type": "commonjs",
  "bin": {
    "career-facilitator": "bin/career.cjs",
    "career": "bin/career.cjs"
  },
  "files": [
    "bin",
    "src",
    ".env.example"
  ],
  "scripts": {
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:e2e": "jest --selectProjects e2e",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --selectProjects unit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cli": "tsx src/cli/index.ts",
    "dev": "tsx src/cli/index.ts",
    "dev:watch": "tsx watch --include src src/cli/index.ts",
    "build": "tsc",
    "start": "node dist/src/cli/index.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/turndown": "^5.0.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "prettier": "^3.10.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.73.0"
  },
  "dependencies": {
    "ai": "^4.0.0",
    "better-sqlite3": "^11.7.0",
    "drizzle-orm": "^0.38.0",
    "node-html-parser": "^9.0.7",
    "nodemailer": "^10.5.0",
    "pdf-parse": "^1.1.1",
    "playwright": "^1.49.0",
    "playwright-extra": "^4.3.6",
    "tsx": "^4.23.15",
    "turndown": "^7.2.0",
    "undici": "^7.30.2",
    "zod": "^3.24.0"
  }
}
