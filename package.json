{
  "name": "career-facilitator-ts",
  "version": "0.7.0",
  "private": true,
  "description": "CareerFacilator AI — autonomous job prospecting, semantic triage, resume tailoring and assisted application with inference optimization",
  "type": "commonjs",
  "bin": {
    "career-facilitator": "bin/career.cjs",
    "career": "bin/career.cjs"
  },
  "files": [
    "bin",
    "src",
    ".env.example"
  ],
  "scripts": {
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:e2e": "jest --selectProjects e2e",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --selectProjects unit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cli": "tsx src/cli/index.ts",
    "dev": "tsx src/cli/index.ts",
    "dev:watch": "tsx watch --include src src/cli/index.ts",
    "build": "tsc",
    "start": "node dist/src/cli/index.js",
    "bundle": "node scripts/bundle.mjs",
    "sea": "node --experimental-sea-config sea-config.json",
    "inject": "node scripts/inject-sea.mjs",
    "build:exe": "npm run bundle && npm run sea && npm run inject",
    "build:runtime": "node scripts/build-runtime.mjs",
    "package:dist": "node scripts/package-release.mjs",
    "dist": "npm run build:exe && npm run build:runtime && npm run package:dist"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/turndown": "^5.0.6",
    "archiver": "^8.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.10.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.73.0"
  },
  "dependencies": {
    "ai": "^4.0.0",
    "imapflow": "^2.12.2",
    "node-html-parser": "^9.0.7",
    "nodemailer": "^10.5.0",
    "pdf-parse": "^1.1.1",
    "playwright": "^1.49.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "qrcode-terminal": "^0.12.0",
    "tesseract.js": "^5.1.1",
    "tsx": "^4.23.15",
    "turndown": "^7.2.0",
    "undici": "^7.30.2",
    "zod": "^3.24.0"
  }
}
