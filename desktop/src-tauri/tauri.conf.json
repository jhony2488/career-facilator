{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CareerFacilator AI",
  "version": "0.9.0",
  "identifier": "dev.careerfacilator.ui",
  "build": {
    "frontendDist": "../../src/ui/public"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "externalBin": ["binaries/career"],
    "resources": {
      "binaries/career-runtime": "career-runtime/",
      "binaries/skills": "skills/"
    },
    "category": "DeveloperTool",
    "shortDescription": "Job discovery, semantic triage, resume tailoring and assisted application",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Portuguese-BR", "English"]
      }
    }
  }
}
