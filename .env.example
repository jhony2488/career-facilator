# CareerFacilator AI — template de configuração local.
# Copie para .env e ajuste. .env é gitignored — nunca commitar chaves reais.

# ── Modo de execução ─────────────────────────────────────────
# FULL_AUTO | SEMI_AUTO | HYBRID_THRESHOLD
EXECUTION_MODE=HYBRID_THRESHOLD

# ── Ollama (local, custo zero) ───────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── Provider + modelo por tier ───────────────────────────────
# Tiers: LOCAL (triagem barata) · FAST (fallback nuvem) · SMART (raciocínio+cache)
# Providers válidos: ollama, groq, anthropic, openai, kimi, gemini — ou qualquer
# outro nome; a API key é lida de <PROVIDER>_API_KEY.

AI_LOCAL_PROVIDER=ollama
AI_LOCAL_MODEL=qwen2.5:7b

AI_FAST_PROVIDER=ollama
AI_FAST_MODEL=qwen2.5:3b

AI_SMART_PROVIDER=ollama
AI_SMART_MODEL=qwen2.5:14b

# ── Providers em nuvem ───────────────────────────────────────

# Groq — https://console.groq.com
# AI_FAST_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant

# Anthropic — https://console.anthropic.com
# AI_SMART_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# OpenAI — https://platform.openai.com
# AI_SMART_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Kimi (Moonshot) — https://platform.moonshot.ai
# AI_SMART_PROVIDER=kimi
# KIMI_API_KEY=
# KIMI_MODEL=moonshot-v1-8k

# Gemini — https://aistudio.google.com
# AI_SMART_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
