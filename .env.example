# CareerFacilator AI — template de configuração local.
# Copie para .env e ajuste. .env é gitignored — nunca commitar chaves reais.

# ── Modo de execução ─────────────────────────────────────────
# FULL_AUTO | SEMI_AUTO | HYBRID_THRESHOLD
EXECUTION_MODE=HYBRID_THRESHOLD

# ── Réguas e alvo de prospecção ──────────────────────────────
# FIT_MIN_SCORE=75             # aderência mínima p/ ir ao tailoring (default 75)
# FIT_AUTO_SCORE=88            # aderência p/ envio 100% automático (default 88)
# JOB_TITLES=Desenvolvedor Full Stack,Backend Developer   # títulos a procurar (vírgula)

# ── Ollama (local, custo zero) ───────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── Provider + modelo por tier ───────────────────────────────
# Tiers: LOCAL (triagem barata) · FAST (fallback nuvem) · SMART (raciocínio+cache)
# Providers válidos: ollama, groq, anthropic, openai, kimi, gemini — ou qualquer
# outro nome; a API key é lida de <PROVIDER>_API_KEY.

AI_LOCAL_PROVIDER=ollama
AI_LOCAL_MODEL=hermes3:latest

AI_FAST_PROVIDER=ollama
AI_FAST_MODEL=hermes3:latest

AI_SMART_PROVIDER=ollama
AI_SMART_MODEL=hermes3:latest

# ── Tuning Ollama / geração ──────────────────────────────────
OLLAMA_KEEP_ALIVE=10m          # tempo do modelo em RAM (-1=nunca descarrega, 0=descarrega na hora)
# AI_TEMPERATURE=0.2           # criatividade (default do modelo se vazio)
# AI_NUM_PREDICT=2048          # teto de tokens de saída
# AI_NUM_CTX=8192              # janela de contexto (default Ollama ~2048 — baixo p/ CV longo) (defaults: 512 triagem / 3072 perfil / 4096 tailor)
# AI_TIMEOUT_MS=600000         # timeout por chamada LLM (10 min default — 7-8B em CPU precisa)
# AI_THINK_ENABLED=true        # pede canal 'thinking' (deepseek-r1/qwen3) + exibe em cinza no CLI

# ── Preflight + fallback ─────────────────────────────────────
# Antes de usar IA, o CLI testa endpoint+modelo e oferece fallback (no shell).
# AI_PREFLIGHT_ENABLED=true    # false desliga o teste
# AI_PREFLIGHT_TIMEOUT_MS=8000 # tempo máx por probe
# AI_FALLBACK_ENABLED=true     # master switch de fallbacks
# AI_LOCAL_FALLBACK=fast       # off | <tier> | <provider>:<modelo>
# AI_SMART_FALLBACK=fast       # ex.: groq:llama-3.3-70b ou ollama:llama3.2
# AI_FAST_FALLBACK=off         # o próprio tier de fallback não tem fallback

# ── RAG semântico (opcional — léxico é o default) ────────────
# AI_EMBEDDINGS_ENABLED=true   # requer `ollama pull nomic-embed-text`
# OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Filtro léxico Camada 0 ───────────────────────────────────
# Termos do perfil que precisam aparecer na vaga p/ não pular (default 1).
# Suba p/ 2-3 se quiser ser mais seletivo antes da triagem.
# LEXICAL_MIN_TERMS=1

# ── Providers em nuvem ───────────────────────────────────────

# Groq — https://console.groq.com
# AI_FAST_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant

# Anthropic — https://console.anthropic.com
# AI_SMART_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# OpenAI — https://platform.openai.com
# AI_SMART_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Kimi (Moonshot) — https://platform.moonshot.ai
# AI_SMART_PROVIDER=kimi
# KIMI_API_KEY=
# KIMI_MODEL=moonshot-v1-8k

# Gemini — https://aistudio.google.com
# AI_SMART_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# ─── Diretório de dados ────────────────────────────────────────────
# Onde a CLI guarda storage/, profile.master, jobs.sqlite e este .env.
# Default global: ~/.careerfacilator. Em dev no repo, use CAREER_HOME=. (já no .env local).
# CAREER_HOME=/caminho/customizado
# Overrides finos: PROFILE_INBOX_DIR, PROFILE_DRAFT_PATH, PROFILE_MASTER_PATH,
# PROFILE_COMPILED_PATH, PROFILE_HISTORY_DIR, JOBS_DB_PATH

# ─── Canal e-mail (docs 11/14) ────────────────────────────────────────────
# Credenciais SMTP NÃO vão aqui — use `career vault set smtp-main` no shell.
# EMAIL_ENABLED=true             # false desliga o canal
# EMAIL_DISPATCH_MODE=HYBRID_BY_SCORE   # REQUIRE_REVIEW | HYBRID_BY_SCORE | AUTO_SEND_HIGH_FIT
# EMAIL_MAX_DAILY=45             # teto de e-mails/dia (default 45)
# EMAIL_MIN_SCORE_AUTO_SEND=88   # régua do modo híbrido
# EMAIL_SMTP_CREDENTIAL_REF=smtp-main   # ref do segredo no cofre
# EMAIL_COOLDOWN_DAYS=30         # anti-duplicidade por destinatário
# EMAIL_RETRY_MAX=3              # falha transitória → NEEDS_HUMAN_INPUT após N tentativas
# EMAIL_RETRY_BACKOFF_MS=60000
# EMAIL_TEMPLATE_PATH=           # modelo de corpo (placeholders {{linkedin}} {{github}}…)
# EMAIL_INCLUDE_SALARY=true      # linha de pretensão salarial no corpo
# CAREER_VAULT_SECRET=           # chave do cofre — guarde-a; sem ela nada descriptografa

# ─── Canal WhatsApp (doc 15) ──────────────────────────────────────────────
# WHATSAPP_ENABLED=true
# WHATSAPP_MODE=MANUAL_QUEUE     # MANUAL_QUEUE (default, fila no review) | EVOLUTION_API
# EVOLUTION_API_URL=http://localhost:8080
# EVOLUTION_API_KEY=             # apikey do seu servidor Evolution API (self-hosted)
# EVOLUTION_INSTANCE=default     # criado/emparelhado via `career whatsapp setup` (QR no terminal)
# WHATSAPP_TEMPLATE_PATH=        # template próprio; ausente → mesmo modelo do e-mail
# WHATSAPP_COOLDOWN_DAYS=30
# WHATSAPP_ATTACH_RESUME=true    # envia o PDF do currículo junto
# WHATSAPP_RETRY_MAX=3
# WHATSAPP_RETRY_BACKOFF_MS=60000
